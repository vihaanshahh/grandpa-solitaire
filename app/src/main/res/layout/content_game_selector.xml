<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewGameChooser"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_alignParentTop="true"
    android:layout_alignParentEnd="true"
    android:layout_alignParentRight="true"
    tools:context="de.tobiasbielefeld.solitaire.ui.GameSelector">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- grandpa-solitaire: big, obvious button to resume the last game -->
        <Button
            android:id="@+id/buttonContinueGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/grandpa_continue_button"
            android:minHeight="80dp"
            android:padding="16dp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TableLayout
            android:id="@+id/tableLayoutGameChooser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

        </TableLayout>
    </LinearLayout>


</ScrollView>
